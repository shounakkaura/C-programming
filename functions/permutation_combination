#include <stdio.h>
int factorial(int n)
{
    if (n < 0)
    {
        return 0;
    }
    int i, fact = 1;
    for (i = 2; i <= n; i++)
    {
        fact *= i;
    }
    return fact;
}

int combination(int n, int r)
{
    if (n < 0 || r < 0 || r > n)
    {
        return 0;
    }
    return factorial(n) / (factorial(r) * factorial(n - r));
}
int permutation(int n, int r)
{
    if (n < 0 || r < 0 || r > n)
    {
        return 0;
    }
    return factorial(n) / factorial(n - r);
}
int main()
{
    int n, r, ans = 0;
    char a;
    printf("Enter a n: ");
    scanf("%d", &n);
    printf("Enter a r: ");
    scanf("%d", &r);
    printf("Enter a C for combination or P for permutation : ");
    scanf(" %c", &a);
    if (a == 'C' || a == 'c')
    {
        ans = combination(n, r);
        printf("Result: %d", ans);
    }
    else if (a == 'P' || a == 'p')
    {
        ans = permutation(n, r);
        printf("Result: %d", ans);
    }
    else
        printf("Enter P or C");

    return 0;
}